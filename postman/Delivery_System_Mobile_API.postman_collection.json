{
  "info": {
    "_postman_id": "b3e94a82-3d84-47c0-8a19-9f447a126dc1",
    "name": "Delivery System - Mobile API (Merchant & Driver)",
    "description": "Complete Postman collection for Delivery SaaS Mobile API, including Authentication, Merchant endpoints (Deliveries realtime, Pickup requests realtime, Settlements, Dashboard, Parcels, Branches) and Driver endpoints (Tasks, Scans, Settlements, Daily invoices).",
