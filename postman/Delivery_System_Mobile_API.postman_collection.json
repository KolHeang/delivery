  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Merchant Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.access_token) {",
                  "    pm.collectionVariables.set('merchant_token', res.data.access_token);",
                  "    pm.collectionVariables.set('merchant_id', res.data.user ? res.data.user.id : 1);",
                  "    console.log('Saved merchant_token to variables!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"012345678\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mobile/auth/merchant/login",
              "host": ["{{base_url}}"],
              "path": ["api", "mobile", "auth", "merchant", "login"]
            },
            "description": "Login as merchant with phone or email. Token will automatically be saved into {{merchant_token}} collection variable."
          }
        },
        {
          "name": "Driver Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.access_token) {",
                  "    pm.collectionVariables.set('driver_token', res.data.access_token);",
                  "    pm.collectionVariables.set('driver_id', res.data.user ? res.data.user.id : 1);",
                  "    console.log('Saved driver_token to variables!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"012345678\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mobile/auth/driver/login",
              "host": ["{{base_url}}"],
              "path": ["api", "mobile", "auth", "driver", "login"]
            },
            "description": "Login as driver with driver code (e.g. DRV001), phone, or email. Token will automatically be saved into {{driver_token}} variable."
          }
